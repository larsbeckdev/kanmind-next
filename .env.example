# Copy to .env and fill in DJANGO_SECRET_KEY. Compose reads .env
# automatically; every value below has a default except the secret key.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Host ports
API_PORT=3070
WEB_PORT=3071

# Django
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
GUNICORN_WORKERS=3

# Only needed behind a TLS terminating proxy: the origin the admin login is
# submitted from, plus trusting the X-Forwarded-Proto header.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=0

# Comma separated origins the frontend is served from, scheme and host only,
# no path and no trailing slash: https://kanmind.example.com. Empty allows
# every origin, which is what development in the local network needs.
DJANGO_CORS_ALLOWED_ORIGINS=

# Leave empty unless the API is not reachable at
# http://<host the frontend was opened from>:<API_PORT>/api, for example
# when a proxy in front puts it on a domain: https://api.example.com/api
NEXT_PUBLIC_API_BASE_URL=
