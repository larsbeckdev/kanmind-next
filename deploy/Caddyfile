{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Collected Django static files, written to the shared volume by
	# collectstatic on every start of the api container.
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	@django path /api/* /admin/* /admin
	handle @django {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
